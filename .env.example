# ==============================================================================
# VíaAlerta · Variables de entorno de ejemplo
# Copia este archivo a ".env" y completa los valores de tu proyecto Supabase.
# NUNCA publiques claves reales ni la service_role key en Git o en la app móvil.
# ==============================================================================

# URL pública de tu proyecto Supabase (Settings -> API -> Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública (anon / publishable key). Es segura para el cliente con RLS activo.
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_publica_aqui

# Esquema de enlace profundo para verificación de correo y recuperación de contraseña
EXPO_PUBLIC_APP_SCHEME=viaalerta

# ==============================================================================
# SOLO SERVIDOR (Supabase Edge Functions -> `supabase secrets set ...`)
# NO prefijes estas variables con EXPO_PUBLIC_ ni las incluyas en el cliente.
# ==============================================================================
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="VíaAlerta <notificaciones@tudominio-verificado.pe>"
# APP_PUBLIC_URL=viaalerta://
# CRON_SECRET=clave_aleatoria_para_procesar_eliminaciones_programadas
